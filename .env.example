# Copy this file to .env and fill in your own values.
# .env is git-ignored -- never commit real credentials or connection URIs.

# --- CognoDB Cloud (managed, free c0 instance) ---
COGNODB_URI=bolt+s://<instance-id>.databases.cognodb.cloud
COGNODB_USER=cognodb
COGNODB_PASSWORD=

# --- Neo4j (self-hosted via docker-compose, capped to 0.5 vCPU / 512MB) ---
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=benchmark-local-only

# --- Memgraph (self-hosted via docker-compose, capped to 0.5 vCPU / 512MB) ---
MEMGRAPH_URI=bolt://localhost:7688
MEMGRAPH_USER=
MEMGRAPH_PASSWORD=

# --- FalkorDB (self-hosted via docker-compose, capped to 0.5 vCPU / 512MB) ---
FALKORDB_HOST=localhost
FALKORDB_PORT=6379
FALKORDB_GRAPH=benchmark

# --- ArangoDB (self-hosted via docker-compose, capped to 0.5 vCPU / 512MB) ---
ARANGODB_URL=http://localhost:8529
ARANGODB_USER=root
ARANGODB_PASSWORD=benchmark-local-only
ARANGODB_DB=benchmark
